# Copy this file to .env (`cp .env.example .env`) to get a working local
# setup immediately — these values match what `npm run db:up` starts
# (Postgres 16 in Docker, container "n5deal-pg"), they aren't secrets.
#
# In production these come from Neon instead: DATABASE_URL is the pooled
# (`-pooler`) connection string, DIRECT_URL is the direct one. Locally
# there's no pooler, so both point at the same container. See README.md
# "Deploying" and ARCHITECTURE.md "Persistence & driver adapter".
DATABASE_URL="postgresql://n5deal:n5deal@localhost:55432/n5deal?schema=public"
DIRECT_URL="postgresql://n5deal:n5deal@localhost:55432/n5deal?schema=public"

# iron-session cookie encryption key — 32+ char random string.
# Generate a real one with: openssl rand -base64 32
SESSION_SECRET="replace-with-a-real-32-char-secret-before-running"
